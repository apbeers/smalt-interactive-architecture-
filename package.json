{
  "name": "smalt-architecture",
  "version": "0.1.0",
  "private": true,
  "description": "The smalt family's repositories as one interactive architecture, generated by a static analyzer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fetch": "node bin/run.mjs fetch",
    "build": "node bin/run.mjs build",
    "test": "node --import ./scripts/register.mjs --test test/*.test.ts",
    "check": "npm test",
    "serve": "cd _site && python3 -m http.server 8080"
  }
}
